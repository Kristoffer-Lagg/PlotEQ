# Capacitor release-signing configuration.
#
# Copy this file to `android/keystore.properties` and fill in the real
# values. The real file is gitignored — never commit it.
#
# `storeFile` is an absolute path to the keystore. We keep the keystore
# OUTSIDE the repo (currently in the legacy ploteq-android Bubblewrap
# folder) so that even if the repo is published, the signing material
# never leaves your machine.
#
# Use forward slashes or escaped backslashes — Gradle Properties files
# treat `\` as an escape character.

storeFile=C:/Users/loffi/Documents/Github Code/ploteq-android/android.keystore
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=android
keyPassword=YOUR_KEY_PASSWORD
